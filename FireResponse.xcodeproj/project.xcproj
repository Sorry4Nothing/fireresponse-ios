{
  "default-configuration": "Release",
  "configurations": [
    {
      "name": "Debug",
      "file": {
        "anchor": "Config",
        "relative-path": "Debug.xcconfig"
      }
    },
    {
      "name": "Release",
      "file": {
        "anchor": "Config",
        "relative-path": "Release.xcconfig"
      }
    }
  ],
  "localizations": {
    "development": "de"
  },
  "files": [
    {
      "kind": "folder",
      "path": "FireResponse",
      "target-membership": [
        "FireResponse"
      ]
    },
    {
      "kind": "folder",
      "path": "FireResponseTests",
      "target-membership": [
        "FireResponseTests"
      ]
    },
    {
      "kind": "folder",
      "path": "Config"
    },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        {
          "path": "<PRODUCTS>/FireResponse.app",
          "id": "000000000000000000000120",
          "type": "wrapper.application",
          "index": false
        },
        {
          "path": "<PRODUCTS>/FireResponseTests.xctest",
          "id": "000000000000000000000121",
          "type": "wrapper.cfbundle",
          "index": false
        }
      ]
    }
  ],
  "targets": [
    {
      "name": "FireResponse",
      "id": "000000000000000100000000",
      "product": "Products/FireResponse.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources"
      ],
      "build-settings": {
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "MARKETING_VERSION": "1.0.0",
        "GENERATE_INFOPLIST_FILE": "YES",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "ENABLE_PREVIEWS": "YES",
        "INFOPLIST_FILE": "Config/Info.plist",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents": "YES",
        "LD_RUNPATH_SEARCH_PATHS": "@executable_path/Frameworks",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES"
      }
    },
    {
      "name": "FireResponseTests",
      "id": "000000000000000100000001",
      "product": "Products/FireResponseTests.xctest",
      "product-type": "bundle.unit-test",
      "test-host-target": "FireResponse",
      "dependencies": [
        "FireResponse"
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources"
      ],
      "build-settings": {
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "MARKETING_VERSION": "1.0.0",
        "GENERATE_INFOPLIST_FILE": "YES",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "PRODUCT_BUNDLE_IDENTIFIER": "$(APP_BUNDLE_IDENTIFIER).tests",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/FireResponse.app/FireResponse"
      }
    }
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "COPY_PHASE_STRIP": "NO",
    "DEAD_CODE_STRIPPING": "YES",
    "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "GCC_C_LANGUAGE_STANDARD": "gnu17",
    "GCC_NO_COMMON_BLOCKS": "YES",
    "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
    "LOCALIZATION_PREFERS_STRING_CATALOGS": "YES",
    "SDKROOT": "iphoneos",
    "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "ENABLE_NS_ASSERTIONS[config=Release]": "NO",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "GCC_PREPROCESSOR_DEFINITIONS[config=Debug]": [
      "DEBUG=1",
      "$(inherited)"
    ],
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "MTL_ENABLE_DEBUG_INFO[config=Debug]": "INCLUDE_SOURCE"
  },
  "last-upgrade": "27.0",
  "last-swift-update": "27.0"
}